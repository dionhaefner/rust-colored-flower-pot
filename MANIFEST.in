include Cargo.toml Cargo.lock rust-toolchain.toml LICENSE THIRD_PARTY_NOTICES.md README.md
include pyproject.toml
recursive-include src *
recursive-include python/rcfp *.py
include python/native.c
recursive-include packaging *.py *.sh *.txt
prune python/terracotta
prune python/terracotta_rust
prune validation
prune execution
prune .github
recursive-include tests *.rs
include validation/tools/cargo.sh
global-exclude __pycache__ *.py[cod]
