FROM public.ecr.aws/lambda/python:3.12 AS build
RUN dnf install -y gcc gcc-c++ make perl-core expat zlib tar gzip && dnf clean all
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.85.1 --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"
RUN python -m pip install rasterio==1.4.3
WORKDIR /workspace
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src
COPY tests ./tests
COPY python ./python
COPY packaging ./packaging
COPY validation/tools/cargo.sh validation/tools/cargo.sh
COPY LICENSE THIRD_PARTY_NOTICES.md ./
RUN cargo fetch --locked && RUSTFLAGS='-C link-arg=-Wl,--disable-new-dtags,-rpath,$ORIGIN' cargo build --locked --release
RUN TERRACOTTA_NATIVE_TARGET=/workspace/target TERRACOTTA_REFERENCE_PYTHON=/var/lang/bin/python packaging/build-bundle.sh /bundle && \
    cp -aL /usr/lib64/libstdc++.so.6 /usr/lib64/libgcc_s.so.1 /usr/lib64/libexpat.so.1 /usr/lib64/libz.so.1 /bundle/lib/
FROM scratch
COPY --from=build /bundle /bundle
CMD ["/bundle/bin/terracotta", "--version-json"]
